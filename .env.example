# ─── Auth ───────────────────────────────────────────────────────────────────
AUTH_SECRET=

# ─── Database ────────────────────────────────────────────────────────────────
# DATABASE_URL pasa por el pooler; DIRECT_URL va directo y lo usan las migraciones.
DATABASE_URL=postgresql://user:password@host:6543/postgres
DIRECT_URL=postgresql://user:password@host:5432/postgres

# ─── Supabase ────────────────────────────────────────────────────────────────
# Usadas por el login (src/lib/auth.ts), que llama al RPC `authenticate`.
NEXT_PUBLIC_SUPABASE_URL=https://yourproject.supabase.co
SUPABASE_ANON_KEY=

# ─── Odoo.sh ─────────────────────────────────────────────────────────────────
# ODOO_LOGIN es el correo del usuario; ODOO_API_KEY reemplaza su contraseña
# (Odoo → Mi perfil → Seguridad). La autenticación falla sin ODOO_LOGIN.
ODOO_BASE_URL=https://yourinstance.odoo.com
ODOO_LOGIN=
ODOO_API_KEY=
ODOO_DB=

# ─── OpenAI ──────────────────────────────────────────────────────────────────
OPENAI_API_KEY=

# ─── WhatsApp / 360dialog ────────────────────────────────────────────────────
WHATSAPP_API_KEY=
WHATSAPP_NUMBER_ID=

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Vercel Cron ─────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=
